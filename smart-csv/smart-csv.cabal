cabal-version:      2.2
name:               smart-csv
version:            0.2.0.0
description:        Smart CSV extraction primitives
homepage:           https://github.com/kronor-io/smart-csv#readme
bug-reports:        https://github.com/kronor-io/smart-csv/issues
author:             Kronor Team
maintainer:         dev@kronor.io
copyright:          2026 Kronor
license:            BSD-3-Clause
license-file:       LICENSE
build-type:         Simple
extra-source-files: README.md
extra-doc-files:    CHANGELOG.md

source-repository head
  type:     git
  location: https://github.com/kronor-io/smart-csv

flag lint
  description: lint
  manual:      True
  default:     False

flag prod
  description: prod
  manual:      True
  default:     False

common common-component-settings
  if flag(prod)
    ghc-options: -O2

  else
    ghc-options: -O0

  if flag(lint)
    ghc-options: -Werror

  default-language: GHC2024
  default-extensions:
      RecordWildCards
    , ScopedTypeVariables
    , TemplateHaskell
    , ApplicativeDo
    , BlockArguments
    , DataKinds
    , DeepSubsumption
    , DefaultSignatures
    , DeriveAnyClass
    , DerivingStrategies
    , DerivingVia
    , DuplicateRecordFields
    , FunctionalDependencies
    , GADTs
    , LambdaCase
    , MultiWayIf
    , NoImplicitPrelude
    , OverloadedRecordDot
    , OverloadedStrings
    , PackageImports
    , PartialTypeSignatures
    , PatternSynonyms
    , QuasiQuotes
    , StrictData
    , TypeFamilies
    , ViewPatterns

library
  import: common-component-settings
  exposed-modules:
    SmartCsv.ColumnConfig
    SmartCsv.Deflate
    SmartCsv.ErrorHandling
    SmartCsv.ExportFormat
    SmartCsv.Flatten
    SmartCsv.Notification
    SmartCsv.Pagination
    SmartCsv.Query
    SmartCsv.Schema
    SmartCsv.TokenClaims
    SmartCsv.Validation
    SmartCsv.Xlsx

  other-modules:    Paths_smart_csv
  hs-source-dirs:   src
  -- crc32 comes from zlib.h
  pkgconfig-depends: zlib
  build-depends:
      aeson
    , base                   >=4.11     && <10
    , bytestring
    , cassava
    , containers
    , morpheus-graphql-core
    , rio                    >=0.1.12.0
    , scientific
    , streaming-commons
    , text
    , vector

test-suite smart-csv-test
  import: common-component-settings
  type:             exitcode-stdio-1.0
  ghc-options:      -main-is Test.SmartCsv.main
  main-is:          Test/SmartCsv.hs
  other-modules:    Test.SmartCsv.Xlsx
  hs-source-dirs:   test
  build-depends:
      aeson
    , base
    , bytestring
    , containers
    , smart-csv
    , morpheus-graphql-core
    , rio                      >=0.1.12.0
    , tasty
    , tasty-hunit
    , text
    , vector
    , zlib
