cabal-version:      2.2
name:               smart-csv
version:            0.1.0.0
description:        Smart CSV extraction primitives
homepage:           https://github.com/kronor-io/smart-csv#readme
bug-reports:        https://github.com/kronor-io/smart-csv/issues
author:             Kronor Team
maintainer:         dev@kronor.io
copyright:          2026 Kronor
license:            BSD-3-Clause
license-file:       LICENSE
build-type:         Simple
extra-source-files: README.md

source-repository head
  type:     git
  location: https://github.com/kronor-io/smart-csv

flag lint
  description: lint
  manual:      True
  default:     False

flag prod
  description: prod
  manual:      True
  default:     False

common common-component-settings
  if flag(prod)
    ghc-options: -O2

  else
    ghc-options: -O0

  if flag(lint)
    ghc-options: -Werror

  default-language: GHC2024
  default-extensions:
      RecordWildCards
    , ScopedTypeVariables
    , TemplateHaskell
    , ApplicativeDo
    , BlockArguments
    , DataKinds
    , DeepSubsumption
    , DefaultSignatures
    , DeriveAnyClass
    , DerivingStrategies
    , DerivingVia
    , DuplicateRecordFields
    , FunctionalDependencies
    , GADTs
    , LambdaCase
    , MultiWayIf
    , NoImplicitPrelude
    , OverloadedRecordDot
    , OverloadedStrings
    , PackageImports
    , PartialTypeSignatures
    , PatternSynonyms
    , QuasiQuotes
    , StrictData
    , TypeFamilies
    , ViewPatterns

library
  import: common-component-settings
  exposed-modules:
    Kronor.SmartCsv.ColumnConfig
    Kronor.SmartCsv.Deflate
    Kronor.SmartCsv.ErrorHandling
    Kronor.SmartCsv.ExportFormat
    Kronor.SmartCsv.Flatten
    Kronor.SmartCsv.Notification
    Kronor.SmartCsv.Pagination
    Kronor.SmartCsv.Query
    Kronor.SmartCsv.Schema
    Kronor.SmartCsv.TokenClaims
    Kronor.SmartCsv.Validation
    Kronor.SmartCsv.Xlsx

  other-modules:    Paths_smart_csv
  hs-source-dirs:   src
  -- crc32 comes from zlib.h
  pkgconfig-depends: zlib
  -- The lower bounds are the runner's versions (cabal.project.freeze), the upper
  -- bounds allow Kronor's (cabal.project.kronor.freeze); CI builds and tests both.
  build-depends:
      aeson                  >=2.2.3    && <2.4
    , base                   >=4.21     && <5
    , bytestring             >=0.12     && <0.13
    , cassava                >=0.5.4    && <0.6
    , containers             >=0.6.8    && <0.8
    , morpheus-graphql-core  >=0.27.3   && <0.29
    , rio                    >=0.1.24   && <0.2
    , scientific             >=0.3.8    && <0.4
    , streaming-commons      >=0.2.3    && <0.3
    , text                   >=2.1      && <2.2
    , vector                 >=0.13.2   && <0.14

test-suite smart-csv-test
  import: common-component-settings
  type:             exitcode-stdio-1.0
  ghc-options:      -main-is Test.Kronor.SmartCsv.main
  main-is:          Test/Kronor/SmartCsv.hs
  other-modules:    Test.Kronor.SmartCsv.Xlsx
  hs-source-dirs:   test
  build-depends:
      aeson
    , base
    , bytestring
    , containers
    , smart-csv
    , morpheus-graphql-core
    , rio                      >=0.1.12.0
    , tasty
    , tasty-hunit
    , text
    , vector
    , zlib
